<mxfile host="Kiro" version="24.0.0" type="device">
  <diagram id="overview" name="High-level flow (all touch points)">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="TTL" value="IDA117V - Child Support Grant reach-gap prioritiser" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="1340" height="38" as="geometry" />
        </mxCell>
        <mxCell id="SUB" value="High-level pipeline, capture to deployment - every file, script and artefact that touches the flow.&#160;&#160;Primary task: &lt;b&gt;csg_reach_gap&lt;/b&gt;.&#160;&#160;Read the numbered stages as a snake: left to right, then down." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="60" y="58" width="1340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="LEG" value="&lt;b&gt;LEGEND&lt;/b&gt;&#160;&#160;&#160;&#9733; = a decisive touch point&lt;br&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;&#9632;&lt;/font&gt; raw data&#160;&#160;&#160;&lt;font color=&quot;#82b366&quot;&gt;&#9632;&lt;/font&gt; processing / modelling&#160;&#160;&#160;&lt;font color=&quot;#d79b00&quot;&gt;&#9632;&lt;/font&gt; decision gate&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;&#9632;&lt;/font&gt; problem reframing&#160;&#160;&#160;&lt;font color=&quot;#d6b656&quot;&gt;&#9632;&lt;/font&gt; evidence / testing&lt;br&gt;&lt;font color=&quot;#9673a6&quot;&gt;&#9632;&lt;/font&gt; saved artefacts&#160;&#160;&#160;&lt;font color=&quot;#10739e&quot;&gt;&#9632;&lt;/font&gt; stakeholder-facing" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fontSize=10;fillColor=#fcfcfc;strokeColor=#9e9e9e;" vertex="1" parent="1">
          <mxGeometry x="1440" y="30" width="420" height="88" as="geometry" />
        </mxCell>

        <mxCell id="N1" value="&lt;b&gt;&#9312;&#160;&#160;DATA CAPTURE AND SOURCE&lt;/b&gt;&lt;br&gt;Stats SA General Household Survey - annual, national,&lt;br&gt;stratified two-stage, every person in the dwelling listed.&lt;br&gt;&lt;br&gt;&lt;b&gt;TOUCH POINTS&lt;/b&gt;&lt;br&gt;dataset/ghs-2012-person-v2.1.csv&lt;br&gt;&#160;&#160;&#160;... through ghs-2022-person-v1.csv&#160;&#160;&lt;b&gt;(11 files)&lt;/b&gt;&lt;br&gt;analysis/README.md&#160;&#160;the 15-step reproduce order&lt;br&gt;analysis/requirements.txt&#160;&#160;pandas, scikit-learn, torch,&lt;br&gt;&#160;&#160;&#160;matplotlib, streamlit&lt;br&gt;.gitattributes&#160;&#160;routes *.csv and *.joblib through Git LFS&lt;br&gt;&lt;br&gt;&lt;b&gt;OUT&#160;&#160;773,311 raw person records, 2012-2022&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="420" height="270" as="geometry" />
        </mxCell>

        <mxCell id="N2" value="&lt;b&gt;&#9313;&#160;&#160;SCHEMA AND VALUE RECONNAISSANCE&lt;/b&gt;&lt;br&gt;Learn the data before trusting it. Column names are&lt;br&gt;unstable across years; the questionnaire topics are not.&lt;br&gt;&lt;br&gt;&lt;b&gt;TOUCH POINTS&lt;/b&gt;&lt;br&gt;&lt;b&gt;01_schema_scan.py&lt;/b&gt;&#160;&#160;headers + streamed row counts&lt;br&gt;&#160;&#160;&#160;&#8594; out/schema.json (columns and encoding per year)&lt;br&gt;&lt;b&gt;02_column_map.py&lt;/b&gt;&#160;&#160;group columns into thematic domains&lt;br&gt;&lt;b&gt;03_value_probe.py&lt;/b&gt;&#160;&#160;label vs numeric coding, survey-weight&lt;br&gt;&#160;&#160;&#160;sanity (weights should sum near the SA population),&lt;br&gt;&#160;&#160;&#160;sentinel codes 8 / 88 / 9 / 99&lt;br&gt;&lt;b&gt;04_verify_codes.py&lt;/b&gt;&#160;&#160;verify numeric&#8594;label maps against&lt;br&gt;&#160;&#160;&#160;adjacent labelled years on weighted shares&lt;br&gt;&lt;b&gt;05_probe_educ_labour.py&lt;/b&gt;&#160;&#160;the messiest label drift:&lt;br&gt;&#160;&#160;&#160;education, employment status, grant type&lt;br&gt;&lt;br&gt;&lt;b&gt;OUT&#160;&#160;schema.json, coverage_matrix.csv&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="520" y="150" width="420" height="270" as="geometry" />
        </mxCell>

        <mxCell id="N3" value="&lt;b&gt;&#9314;&#160;&#160;IMPORT AND HARMONISE&#160;&#160;&#9733; data enters here&lt;/b&gt;&lt;br&gt;&lt;b&gt;ghs_harmonise.py&lt;/b&gt; - one vocabulary out of eleven files&lt;br&gt;&lt;br&gt;&lt;b&gt;TOUCH POINTS&lt;/b&gt;&lt;br&gt;&lt;b&gt;DATA_DIR&lt;/b&gt; + &lt;b&gt;load_year()&lt;/b&gt;&#160;&#160;pd.read_csv(dtype=str,&lt;br&gt;&#160;&#160;&#160;usecols = whitelist, encoding from schema.json)&lt;br&gt;&lt;b&gt;ALIASES&lt;/b&gt;&#160;&#160;~40 canonical names &#8592; per-year columns&lt;br&gt;&#160;&#160;&#160;weight&#8592;person_wgt, grant&#8592;q132asg|q31asg|soc_grant&lt;br&gt;&lt;b&gt;value maps&lt;/b&gt;&#160;&#160;PROV, SEX, RACE, DISAB, YESNO,&lt;br&gt;&#160;&#160;&#160;GEOTYPE old / new / text&lt;br&gt;&lt;b&gt;MISSING_LABELS / MISSING_NUMERIC&lt;/b&gt;&#160;&#160;sentinels &#8594; NaN&lt;br&gt;&lt;b&gt;_educ_band()&lt;/b&gt;&#160;&#160;32-34 categories &#8594; 5 ordered bands&lt;br&gt;&lt;b&gt;derive_labour_status()&lt;/b&gt;&#160;&#160;Stats SA logic, NaN outside 15-64&lt;br&gt;&lt;b&gt;wshare / wdist / wmean / wmedian&lt;/b&gt;&#160;&#160;weighted helpers&lt;br&gt;&lt;br&gt;&lt;b&gt;OUT&#160;&#160;11 harmonised year frames&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="980" y="150" width="420" height="270" as="geometry" />
        </mxCell>

        <mxCell id="N4" value="&lt;b&gt;&#9315;&#160;&#160;PANEL AND FEATURE BUILD&lt;/b&gt;&lt;br&gt;&lt;b&gt;ghs_dataset.py&lt;/b&gt; + &lt;b&gt;12_eda.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;TOUCH POINTS&lt;/b&gt;&lt;br&gt;&lt;b&gt;PERSON_LOAD&lt;/b&gt;&#160;&#160;the column whitelist actually read&lt;br&gt;&lt;b&gt;LEAKAGE_COLUMNS&lt;/b&gt;&#160;&#160;grant follow-ups never loaded at all&lt;br&gt;&lt;b&gt;build_panel()&lt;/b&gt;&#160;&#160;pool 11 years, hh = year + '_' + uqnr,&lt;br&gt;&#160;&#160;&#160;groupby &#8594; 14 household features, merge onto each person&lt;br&gt;&lt;b&gt;06_indicators.py&lt;/b&gt; / &lt;b&gt;07_charts.py&lt;/b&gt;&#160;&#160;weighted national&lt;br&gt;&#160;&#160;&#160;indicators - proof of what the data can deliver&lt;br&gt;&lt;b&gt;10_household_features.py&lt;/b&gt;&#160;&#160;showed household context&lt;br&gt;&#160;&#160;&#160;beats raw person-level columns&lt;br&gt;&lt;b&gt;12_eda.py&lt;/b&gt;&#160;&#160;data dictionary, class-balance and missingness&lt;br&gt;&#160;&#160;&#160;audits, figures F1-F7, and it caches the panel&lt;br&gt;&lt;br&gt;&lt;b&gt;OUT&#160;&#160;out/analysis_panel.parquet&lt;/b&gt; - the one source every&lt;br&gt;downstream script reads" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1440" y="150" width="420" height="270" as="geometry" />
        </mxCell>

        <mxCell id="N5" value="&lt;b&gt;&#9316;&#160;&#160;TARGET DESIGN - THE REFRAMING&#160;&#160;&#9733;&lt;/b&gt;&lt;br&gt;Where the &lt;i&gt;question&lt;/i&gt; was fixed, not the model.&lt;br&gt;&lt;br&gt;&lt;b&gt;TOUCH POINTS&lt;/b&gt;&lt;br&gt;&lt;b&gt;08_feature_screen.py&lt;/b&gt;&#160;&#160;which columns are leakage, and how&lt;br&gt;&#160;&#160;&#160;much of the target is mechanical age-threshold law&lt;br&gt;&lt;b&gt;09_model_test.py&lt;/b&gt;&#160;&#160;age alone vs legitimate vs leaked&lt;br&gt;&#160;&#160;&#160;predictors; first test of a take-up framing&lt;br&gt;&lt;b&gt;11_target_candidates.py&lt;/b&gt;&#160;&#160;screened other service-delivery&lt;br&gt;&#160;&#160;&#160;targets (feeding scheme, no-fee school, ECD, bursary)&lt;br&gt;&lt;b&gt;17_underreach_gap.py&lt;/b&gt;&#160;&#160;receipt is not the decision -&lt;br&gt;&#160;&#160;&#160;the stakeholder needs the &lt;i&gt;gap&lt;/i&gt;&lt;br&gt;&lt;b&gt;18_eligibility_design.py&lt;/b&gt;&#160;&#160;5 restrictions tested, D3 adopted&lt;br&gt;&lt;b&gt;19_reframed_feasibility.py&lt;/b&gt;&#160;&#160;confirm the harder task has signal&lt;br&gt;&lt;b&gt;ghs_dataset.eligibility_proxy() / get_task()&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;OUT&#160;&#160;y = 1 - grant_any&lt;/b&gt; for children 0-17 in households with&lt;br&gt;no earner and no medical aid&#160;&#160;&#183;&#160;&#160;97,390 rows, 14.26% positive" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="1440" y="470" width="420" height="270" as="geometry" />
        </mxCell>

        <mxCell id="N6" value="&lt;b&gt;&#9317;&#160;&#160;SPLIT&#160;&#160;&#9733; where the data is split&lt;/b&gt;&lt;br&gt;&lt;b&gt;ghs_dataset.build_panel()&lt;/b&gt; writes the label, &lt;b&gt;split_xy()&lt;/b&gt; serves it&lt;br&gt;&lt;br&gt;&lt;b&gt;TOUCH POINTS&lt;/b&gt;&lt;br&gt;&lt;b&gt;TRAIN_YEARS&lt;/b&gt;&#160;&#160;2012-2018&#160;&#160;&#8776; 71,080&#160;&#160;&#8776; 73%&lt;br&gt;&lt;b&gt;VAL_YEARS&lt;/b&gt;&#160;&#160;&#160;&#160;2019-2020&#160;&#160;&#8776; 12,849&#160;&#160;&#8776; 13%&lt;br&gt;&lt;b&gt;TEST_YEARS&lt;/b&gt;&#160;&#160;&#160;2021-2022&#160;&#160;&#160;&#160;13,461&#160;&#160;&#8776; 14%&#160;&#160;&lt;b&gt;locked&lt;/b&gt;&lt;br&gt;&lt;b&gt;time-based, not random&lt;/b&gt; - psu ids repeat within a survey&lt;br&gt;&#160;&#160;&#160;year, so a random split would leak geographic neighbours&lt;br&gt;&lt;b&gt;nested split&lt;/b&gt; in 22_optimise.py: fit 2012-17, stop on 2018,&lt;br&gt;&#160;&#160;&#160;select on 2019-20&lt;br&gt;&lt;b&gt;calibration split&lt;/b&gt;: fit on 2019, check on 2020&lt;br&gt;&lt;b&gt;SEED = 42&lt;/b&gt; in every script&lt;br&gt;&lt;br&gt;&lt;b&gt;OUT&#160;&#160;X, y and survey weight for each of the three splits&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="980" y="470" width="420" height="270" as="geometry" />
        </mxCell>

        <mxCell id="N7" value="&lt;b&gt;&#9318;&#160;&#160;ENCODE AND TRAIN&lt;/b&gt;&lt;br&gt;&lt;b&gt;13_models.py&lt;/b&gt; + &lt;b&gt;ghs_models.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;TOUCH POINTS&lt;/b&gt;&lt;br&gt;&lt;b&gt;make_onehot()&lt;/b&gt;&#160;&#160;median impute + StandardScaler;&lt;br&gt;&#160;&#160;&#160;'__NA__' + OneHotEncoder(min_frequency 50)&lt;br&gt;&lt;b&gt;make_ordinal()&lt;/b&gt;&#160;&#160;ordinal ids for the embedding model&lt;br&gt;&#160;&#160;&#160;&lt;i&gt;both fitted on TRAIN only&lt;/i&gt;&lt;br&gt;&lt;b&gt;Baseline (Dummy, prior)&lt;/b&gt;&#160;&#160;the floor, AUC 0.500&lt;br&gt;&lt;b&gt;Logistic Regression&lt;/b&gt;&#160;&#160;l2, class_weight balanced&lt;br&gt;&lt;b&gt;Random Forest&lt;/b&gt;&#160;&#160;400 trees, depth 18&lt;br&gt;&lt;b&gt;MLP&lt;/b&gt; (256,128,64)&#160;&#160;&#183;&#160;&#160;&lt;b&gt;TabTransformer&lt;/b&gt; (d32, 4 heads, 2 blocks)&lt;br&gt;&lt;b&gt;train_torch()&lt;/b&gt;&#160;&#160;mini-batch, early stopping on validation AUC&lt;br&gt;&lt;b&gt;metrics()&lt;/b&gt;&#160;&#160;all survey-weighted, plus precision@k and lift@k&lt;br&gt;&lt;b&gt;ghs_models.py&lt;/b&gt;&#160;&#160;architectures kept byte-compatible with&lt;br&gt;&#160;&#160;&#160;the saved state dicts so training and serving cannot drift&lt;br&gt;&lt;br&gt;&lt;b&gt;OUT&#160;&#160;champion MLP, comparator Random Forest&lt;/b&gt;, F8-F11, F13,&lt;br&gt;hyperparameters_csg_reach_gap.json" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="520" y="470" width="420" height="270" as="geometry" />
        </mxCell>

        <mxCell id="N8" value="&lt;b&gt;&#9319;&#160;&#160;OPTIMISE&lt;/b&gt;&lt;br&gt;&lt;b&gt;22_optimise.py&lt;/b&gt; + &lt;b&gt;23_complete_optimisation.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;TOUCH POINTS&lt;/b&gt;&lt;br&gt;&lt;b&gt;40-trial random search&lt;/b&gt;, scored on survey-weighted&lt;br&gt;&#160;&#160;&#160;PR-AUC over 2019-2020&lt;br&gt;&lt;b&gt;space&lt;/b&gt;&#160;&#160;hidden, dropout, lr, weight decay, batch size,&lt;br&gt;&#160;&#160;&#160;pos_weight, min_frequency, use_sensitive, drop_constant&lt;br&gt;&lt;b&gt;DEAD list&lt;/b&gt;&#160;&#160;the 5 features that are constant inside the&lt;br&gt;&#160;&#160;&#160;eligible population, because they &lt;i&gt;are&lt;/i&gt; the filter&lt;br&gt;&lt;b&gt;winner&lt;/b&gt;&#160;&#160;(512,256,128), dropout 0.1, lr 2e-3, pos_weight 3.0,&lt;br&gt;&#160;&#160;&#160;min_freq 20, race and sex kept &#8594; &lt;b&gt;19-feature contract&lt;/b&gt;&lt;br&gt;&lt;b&gt;leave-one-year-out CV&lt;/b&gt; over the 7 training years&lt;br&gt;&lt;b&gt;single locked test read&lt;/b&gt; on 2021-2022&lt;br&gt;&lt;b&gt;23_*&lt;/b&gt; rebuilds the log and F15 from saved output, so the&lt;br&gt;&#160;&#160;&#160;search does not have to be repeated&lt;br&gt;&lt;br&gt;&lt;b&gt;OUT&#160;&#160;optimised_bundle + mlp_optimised&lt;/b&gt; (pre, num, cat, cfg)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="470" width="420" height="270" as="geometry" />
        </mxCell>

        <mxCell id="N9" value="&lt;b&gt;&#9320;&#160;&#160;CALIBRATE AND SET THE DECISION RULE&lt;/b&gt;&lt;br&gt;&lt;b&gt;15_calibrate.py&lt;/b&gt; + &lt;b&gt;25_calibrate_optimised.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;TOUCH POINTS&lt;/b&gt;&lt;br&gt;&lt;b&gt;IsotonicRegression&lt;/b&gt;&#160;&#160;fit on 2019, checked on 2020&lt;br&gt;&#160;&#160;&#160;&lt;i&gt;class rebalancing inflated the raw scores ~5x&lt;/i&gt;&lt;br&gt;&lt;b&gt;bias, Brier, ECE, AUC&lt;/b&gt; before and after &#8594; F12&lt;br&gt;&#160;&#160;&#160;Brier 0.2066 &#8594; 0.0790&#160;&#160;&#183;&#160;&#160;ECE 0.3511 &#8594; 0.0359&lt;br&gt;&lt;b&gt;monotone&lt;/b&gt;, so the ranking - and therefore lift - is unchanged&lt;br&gt;&lt;b&gt;25_*&lt;/b&gt; calibrates the optimised champion and redoes McNemar&lt;br&gt;&#160;&#160;&#160;fairly, superseding script 24&lt;br&gt;&lt;b&gt;no tuned threshold&lt;/b&gt; - lift bands instead:&lt;br&gt;&#160;&#160;&#160;&#8805; 3.0x Very high&#160;&#183;&#160;&#8805; 2.0x High&#160;&#183;&#160;&#8805; 1.25x Elevated&#160;&#183;&#160;else low&lt;br&gt;&lt;br&gt;&lt;b&gt;OUT&#160;&#160;calibrators_*.joblib, optimised_calibrated_*.npz&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="60" y="790" width="420" height="270" as="geometry" />
        </mxCell>

        <mxCell id="N10" value="&lt;b&gt;&#9321;&#160;&#160;EVALUATE AND STATISTICALLY TEST&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;TOUCH POINTS&lt;/b&gt;&lt;br&gt;&lt;b&gt;20_targeting_figure.py&lt;/b&gt;&#160;&#160;redraws the targeting evidence with&lt;br&gt;&#160;&#160;&#160;random tie-breaking, so a constant predictor no longer&lt;br&gt;&#160;&#160;&#160;appears to have lift &#8594; F13&lt;br&gt;&lt;b&gt;21_ablation_mcnemar.py&lt;/b&gt;&#160;&#160;ablations A0-A8, one controlled&lt;br&gt;&#160;&#160;&#160;change each, plus the pre-optimisation McNemar &#8594; F14&lt;br&gt;&lt;b&gt;24_mcnemar_final.py&lt;/b&gt;&#160;&#160;&lt;i&gt;superseded&lt;/i&gt; - it compared a calibrated&lt;br&gt;&#160;&#160;&#160;forest against an uncalibrated champion at a fixed threshold&lt;br&gt;&lt;b&gt;16_ui_tests.py&lt;/b&gt;&#160;&#160;9 acceptance cases (4 valid, 5 refused) run&lt;br&gt;&#160;&#160;&#160;against the same artefacts the interface loads&lt;br&gt;&lt;b&gt;headline&lt;/b&gt;&#160;&#160;locked test ROC 0.6911, PR 0.2708, lift@5% 3.52&lt;br&gt;&lt;b&gt;champion vs forest&lt;/b&gt;&#160;&#160;p = 0.057 and p = 0.823 &#8594; indistinguishable&lt;br&gt;&lt;br&gt;&lt;b&gt;OUT&lt;/b&gt;&#160;&#160;results_*, ablation_*, mcnemar_*, ui_acceptance_tests.csv" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="520" y="790" width="420" height="270" as="geometry" />
        </mxCell>

        <mxCell id="N11" value="&lt;b&gt;&#9322;&#160;&#160;ARTEFACT STORE&lt;/b&gt;&#160;&#160;analysis/out/&lt;br&gt;The handover boundary: modelling writes, serving reads.&lt;br&gt;&lt;br&gt;&lt;b&gt;TOUCH POINTS&lt;/b&gt;&lt;br&gt;&lt;b&gt;out/&lt;/b&gt;&#160;&#160;schema.json, analysis_panel.parquet, data_dictionary,&lt;br&gt;&#160;&#160;&#160;audit_*, results_val / test / overfit / targeting,&lt;br&gt;&#160;&#160;&#160;calibration_*, optuna_trials_*, optimisation_*,&lt;br&gt;&#160;&#160;&#160;cv_leave_one_year_*, final_locked_*, ablation_*,&lt;br&gt;&#160;&#160;&#160;mcnemar_*, eligibility_restrictions, brief.txt&lt;br&gt;&lt;b&gt;out/models/&lt;/b&gt;&#160;&#160;logreg, randomforest, mlp, tabtransformer,&lt;br&gt;&#160;&#160;&#160;preprocessors&lt;br&gt;&lt;b&gt;out/figures/&lt;/b&gt;&#160;&#160;F1-F15&lt;br&gt;&lt;b&gt;*.npz&lt;/b&gt;&#160;&#160;validation and test scores for every model&lt;br&gt;&lt;br&gt;&lt;b&gt;&#9733; THE FOUR THE APP LOADS&lt;/b&gt;&lt;br&gt;optimised_bundle_*.joblib&#160;&#160;&#183;&#160;&#160;mlp_optimised_*.pt&lt;br&gt;calibrators_*.joblib&#160;&#160;&#183;&#160;&#160;optimised_calibrated_*.npz" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="980" y="790" width="420" height="270" as="geometry" />
        </mxCell>

        <mxCell id="N12" value="&lt;b&gt;&#9323;&#160;&#160;SERVE&#160;&#160;&#9733; stakeholder interface&lt;/b&gt;&lt;br&gt;&lt;b&gt;app.py&lt;/b&gt; + &lt;b&gt;ghs_inference.py&lt;/b&gt; + &lt;b&gt;ghs_schema.py&lt;/b&gt;&#160;&#160;(streamlit run app.py)&lt;br&gt;&lt;br&gt;&lt;b&gt;TOUCH POINTS&lt;/b&gt;&lt;br&gt;&lt;b&gt;app.py&lt;/b&gt;&#160;&#160;3 tabs: single household, batch upload, input guide.&lt;br&gt;&#160;&#160;&#160;Loads saved artefacts only - &lt;b&gt;nothing refits&lt;/b&gt;&lt;br&gt;&lt;b&gt;ghs_schema.py&lt;/b&gt;&#160;&#160;single source of truth for the input contract,&lt;br&gt;&#160;&#160;&#160;so the UI cannot drift from the training data&lt;br&gt;&lt;b&gt;ghs_inference.py&lt;/b&gt;&lt;br&gt;&#160;&#160;&#160;&lt;b&gt;Champion&lt;/b&gt;&#160;&#160;bundle + weights + isotonic calibrator&lt;br&gt;&#160;&#160;&#160;&lt;b&gt;build_row / derive_household&lt;/b&gt;&#160;&#160;the same 14 formulas&lt;br&gt;&#160;&#160;&#160;&lt;b&gt;validate_person / check_in_scope&lt;/b&gt;&#160;&#160;refuse with a reason&lt;br&gt;&#160;&#160;&#160;&lt;b&gt;explain&lt;/b&gt;&#160;&#160;one-at-a-time perturbation, top 5 factors&lt;br&gt;&#160;&#160;&#160;&lt;b&gt;risk_band / percentile / predict_batch&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;OUT&lt;/b&gt;&#160;&#160;calibrated probability, risk band and action, outreach&lt;br&gt;percentile, plain-language factors, ranked batch work list" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=10;fillColor=#b1ddf0;strokeColor=#10739e;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="1440" y="790" width="420" height="270" as="geometry" />
        </mxCell>

        <mxCell id="XC" value="&lt;b&gt;CROSS-CUTTING TOUCH POINTS&lt;/b&gt;&#160;&#160;- these hold at every stage above&lt;br&gt;&lt;b&gt;SEED = 42&lt;/b&gt; in every script, for random, numpy, torch and the batch generator&#160;&#160;&#183;&#160;&#160;&lt;b&gt;survey weight&lt;/b&gt; (person_wgt) used as sample_weight in every reported metric but &lt;b&gt;never&lt;/b&gt; in .fit() or the loss&#160;&#160;&#183;&#160;&#160;&lt;b&gt;LEAKAGE_COLUMNS&lt;/b&gt; never loaded, so no later stage can reintroduce them&#160;&#160;&#183;&#160;&#160;&lt;b&gt;GHS_TASK&lt;/b&gt; environment variable switches between csg_reach_gap (primary), csg_takeup and grant_any&lt;br&gt;&lt;b&gt;test years 2021-2022&lt;/b&gt; are touched exactly once, in 22_optimise.py&#160;&#160;&#183;&#160;&#160;every table and figure lands in &lt;b&gt;analysis/out&lt;/b&gt;&#160;&#160;&#183;&#160;&#160;run order is the &lt;b&gt;15-step table in analysis/README.md&lt;/b&gt; (there is no script 14; scripts 05-11, 17 and 24 are exploration or superseded and sit outside the reproduce path)&lt;br&gt;&lt;b&gt;&#9888; Git LFS&lt;/b&gt; smudge must run or *.joblib arrives as a 129-byte pointer stub and every model load fails - recover with git lfs install, git lfs checkout&#160;&#160;&#183;&#160;&#160;&lt;b&gt;ghs_harmonise.DATA_DIR&lt;/b&gt; is the one absolute path in the project&#160;&#160;&#183;&#160;&#160;all computation is local: no network calls, no credentials, de-identified microdata&lt;br&gt;&lt;b&gt;Responsible use&lt;/b&gt; - the output is a population-level prioritisation score for outreach planning. It must not be used to adjudicate, approve, reduce or deny an individual's grant, and it carries no legal standing." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="1100" width="1800" height="160" as="geometry" />
        </mxCell>

