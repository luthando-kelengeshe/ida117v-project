        <mxCell id="eload" value="loaded at startup" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=3;strokeColor=#9673a6;dashed=1;endArrow=blockThin;endFill=1;fontSize=11;exitX=0.45;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="STORE" target="B4"><mxGeometry relative="1" as="geometry" /></mxCell>
