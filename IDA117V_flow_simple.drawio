<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Kiro" version="24.0.0" type="device">
  <diagram id="simple" name="Simple flow">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="TTL" value="Child Support Grant reach-gap prioritiser - how it flows" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="1100" height="34" as="geometry" />
        </mxCell>

        <mxCell id="HA" value="&lt;b&gt;BUILD&lt;/b&gt;&#160;&#160;-&#160;&#160;offline, run once&#160;&#160;(analysis scripts)" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#2d6a2d;" vertex="1" parent="1">
          <mxGeometry x="40" y="68" width="700" height="24" as="geometry" />
        </mxCell>

        <mxCell id="A1" value="&lt;b&gt;1. GHS CSVs&lt;/b&gt;&lt;br&gt;&lt;br&gt;11 files, 2012-2022&lt;br&gt;773k people" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="155" height="110" as="geometry" />
        </mxCell>
        <mxCell id="A2" value="&lt;b&gt;2. Harmonise&lt;/b&gt;&lt;br&gt;&lt;br&gt;one vocabulary&lt;br&gt;across all years" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="217" y="100" width="155" height="110" as="geometry" />
        </mxCell>
        <mxCell id="A3" value="&lt;b&gt;3. Build panel&lt;/b&gt;&lt;br&gt;&lt;br&gt;add household&lt;br&gt;features" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="394" y="100" width="155" height="110" as="geometry" />
        </mxCell>
        <mxCell id="A4" value="&lt;b&gt;4. Set the target&lt;/b&gt;&lt;br&gt;&lt;br&gt;eligible child&lt;br&gt;with no grant" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="571" y="100" width="155" height="110" as="geometry" />
        </mxCell>
        <mxCell id="A5" value="&lt;b&gt;5. Split&lt;/b&gt;&lt;br&gt;&lt;br&gt;by year:&lt;br&gt;train / val / test" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="748" y="100" width="155" height="110" as="geometry" />
        </mxCell>
        <mxCell id="A6" value="&lt;b&gt;6. Train + tune&lt;/b&gt;&lt;br&gt;&lt;br&gt;5 models,&lt;br&gt;keep the winner" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="925" y="100" width="155" height="110" as="geometry" />
        </mxCell>
        <mxCell id="A7" value="&lt;b&gt;7. Calibrate&lt;/b&gt;&lt;br&gt;&lt;br&gt;make the scores&lt;br&gt;honest" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1102" y="100" width="155" height="110" as="geometry" />
        </mxCell>
        <mxCell id="A8" value="&lt;b&gt;8. Save&lt;/b&gt;&lt;br&gt;&lt;br&gt;model files&lt;br&gt;to disk" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1279" y="100" width="155" height="110" as="geometry" />
        </mxCell>

        <mxCell id="STORE" value="&lt;b&gt;SAVED FILES&lt;/b&gt;&#160;&#160;&#160;preprocessor&#160;&#160;+&#160;&#160;trained weights&#160;&#160;+&#160;&#160;calibrator&#160;&#160;&#160;&#8212;&#160;&#160;&#160;the app just loads these, it never retrains" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="265" width="1394" height="56" as="geometry" />
        </mxCell>

        <mxCell id="HB" value="&lt;b&gt;RUN&lt;/b&gt;&#160;&#160;-&#160;&#160;every prediction&#160;&#160;(app.py)" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#10739e;" vertex="1" parent="1">
          <mxGeometry x="40" y="345" width="700" height="24" as="geometry" />
        </mxCell>

        <mxCell id="B1" value="&lt;b&gt;1. Frontend&lt;/b&gt;&lt;br&gt;&lt;br&gt;user enters the child&lt;br&gt;+ household members" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#b1ddf0;strokeColor=#10739e;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="377" width="155" height="110" as="geometry" />
        </mxCell>
        <mxCell id="B2" value="&lt;b&gt;2. Check&lt;/b&gt;&lt;br&gt;&lt;br&gt;valid input?&lt;br&gt;in scope?" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#b1ddf0;strokeColor=#10739e;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="217" y="377" width="155" height="110" as="geometry" />
        </mxCell>
        <mxCell id="B3" value="&lt;b&gt;3. Build features&lt;/b&gt;&lt;br&gt;&lt;br&gt;turn the roster into&lt;br&gt;19 numbers" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="394" y="377" width="155" height="110" as="geometry" />
        </mxCell>
        <mxCell id="B4" value="&lt;b&gt;4. Preprocess&lt;/b&gt;&lt;br&gt;&lt;br&gt;the saved&lt;br&gt;preprocessor" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="571" y="377" width="155" height="110" as="geometry" />
        </mxCell>
        <mxCell id="B5" value="&lt;b&gt;5. Model&lt;/b&gt;&lt;br&gt;&lt;br&gt;neural net&lt;br&gt;gives a raw score" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="748" y="377" width="155" height="110" as="geometry" />
        </mxCell>
        <mxCell id="B6" value="&lt;b&gt;6. Calibrate&lt;/b&gt;&lt;br&gt;&lt;br&gt;turn it into a real&lt;br&gt;probability" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="925" y="377" width="155" height="110" as="geometry" />
        </mxCell>
        <mxCell id="B7" value="&lt;b&gt;7. Rank&lt;/b&gt;&lt;br&gt;&lt;br&gt;risk band +&lt;br&gt;priority position" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1102" y="377" width="155" height="110" as="geometry" />
        </mxCell>
        <mxCell id="B8" value="&lt;b&gt;8. Show it&lt;/b&gt;&lt;br&gt;&lt;br&gt;answer + reasons,&lt;br&gt;or a ranked CSV" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#b1ddf0;strokeColor=#10739e;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1279" y="377" width="155" height="110" as="geometry" />
        </mxCell>

        <mxCell id="MODEL" value="&lt;b&gt;THE MODEL&lt;/b&gt;&#160;&#160;&#160;a neural network (MLP), trained on 97,390 children&lt;br&gt;&lt;br&gt;&lt;b&gt;GOES IN&lt;/b&gt;&#160;&#160;(independent variables, 19)&#160;&#160;&#160;the child: age, sex, population group, province, settlement type, education, school attendance, disability, labour status&#160;&#160;&#183;&#160;&#160;the household: size, number of children, number of older people, average and oldest age, number unemployed, number disabled, highest education, dependency ratio, income per person&lt;br&gt;&lt;br&gt;&lt;b&gt;COMES OUT&lt;/b&gt;&#160;&#160;(target variable)&#160;&#160;&#160;the probability that this eligible child is &lt;b&gt;not&lt;/b&gt; receiving the Child Support Grant&#160;&#160;&#8594;&#160;&#160;used to decide which households to visit first" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="1394" height="150" as="geometry" />
        </mxCell>

