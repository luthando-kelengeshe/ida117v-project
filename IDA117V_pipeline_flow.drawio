        <mxCell id="e30" value="remove" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#b85450;dashed=1;endArrow=blockThin;endFill=1;fontSize=9;" edge="1" parent="1" source="F3" target="F4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e31" value="encode" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#333333;endArrow=blockThin;endFill=1;fontSize=9;" edge="1" parent="1" source="F4" target="F5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e32" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#333333;dashed=1;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="F5" target="F6"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e33" value="design matrix" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=3;strokeColor=#333333;endArrow=blockThin;endFill=1;fontSize=10;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="F5" target="G5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e34" value="fit on TRAIN" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=3;strokeColor=#333333;endArrow=blockThin;endFill=1;fontSize=10;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="F1" target="G1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e35" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#82b366;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.1;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="G1" target="G7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e36" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#82b366;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="G2" target="G7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e37" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#82b366;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.45;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="G3" target="G7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e38" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=3;strokeColor=#d79b00;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="G4" target="G7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e39" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#82b366;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="G5" target="G7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e40" value="drives early stopping" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#d6b656;dashed=1;endArrow=blockThin;endFill=1;fontSize=9;" edge="1" parent="1" source="G6" target="G5"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e41" value="tune the champion architecture" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=3;strokeColor=#333333;endArrow=blockThin;endFill=1;fontSize=10;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="G7" target="H1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e42" value="best trial" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=3;strokeColor=#d79b00;endArrow=blockThin;endFill=1;fontSize=9;" edge="1" parent="1" source="H1" target="H2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e43" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#333333;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="H2" target="H3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e44" value="retrain, then read the test set once" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#b85450;endArrow=blockThin;endFill=1;fontSize=9;" edge="1" parent="1" source="H3" target="H4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e45" value="save" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#9673a6;endArrow=blockThin;endFill=1;fontSize=9;" edge="1" parent="1" source="H4" target="H5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e46" value="TEST 2021-2022 enters here and nowhere else" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=3;strokeColor=#b85450;dashed=1;endArrow=blockThin;endFill=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="E9" target="H4"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e47" value="raw scores are over-confident" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=3;strokeColor=#333333;endArrow=blockThin;endFill=1;fontSize=10;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="H2" target="I1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e48" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#333333;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="I1" target="I2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e49" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#333333;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="I2" target="I3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e50" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#333333;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="I3" target="I4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e51" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#10739e;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="I4" target="I5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e52" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#10739e;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="I5" target="I6"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e53" value="score the held-out sets" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=3;strokeColor=#333333;endArrow=blockThin;endFill=1;fontSize=10;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="I2" target="J1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e54" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#333333;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="J1" target="J2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e55" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#333333;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="J2" target="J3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e56" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#333333;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="J3" target="J4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e57" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#333333;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="J4" target="J5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e58" value="feeds back into the feature contract" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#b85450;dashed=1;endArrow=blockThin;endFill=1;fontSize=9;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="J4" target="F4"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e59" value="everything is persisted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=3;strokeColor=#9673a6;endArrow=blockThin;endFill=1;fontSize=10;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="J1" target="K1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e60" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#9673a6;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="K1" target="K2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e61" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#9673a6;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="K2" target="K3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e62" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#9673a6;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="K3" target="K4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e63" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#9673a6;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="K4" target="K5"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e64" value="loaded by the app" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=3;strokeColor=#10739e;endArrow=blockThin;endFill=1;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="K2" target="L2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e65" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=3;strokeColor=#10739e;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="L1" target="L2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e66" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=3;strokeColor=#10739e;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="L2" target="L3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e67" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=3;strokeColor=#d79b00;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="L3" target="L4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e68" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=3;strokeColor=#10739e;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="L4" target="L5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e69" value="same path, many rows" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#10739e;dashed=1;endArrow=blockThin;endFill=1;fontSize=9;" edge="1" parent="1" source="L5" target="L6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e70" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=3;strokeColor=#10739e;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="L5" target="L7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e71" value="reference distribution for percentiles and base rate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#9673a6;dashed=1;endArrow=blockThin;endFill=1;fontSize=9;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="K3" target="L4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e72" value="identical household formulas as training" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#82b366;dashed=1;endArrow=blockThin;endFill=1;fontSize=9;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="C3" target="L3"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="flow-vars" name="2. Variables + model card">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="P2T" value="Variable dictionary and model card - csg_reach_gap (deployed champion: &quot;Optimised MLP&quot;)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1500" height="40" as="geometry" />
        </mxCell>

        <mxCell id="V0" value="&lt;b&gt;TARGET (DEPENDENT) VARIABLE&#160;&#160;-&#160;&#160;y&#160;&#160;-&#160;&#160;binary classification&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Population (rows kept):&lt;/b&gt; persons aged 0-17 whose grant answer is present, &lt;b&gt;and&lt;/b&gt; whose household has &lt;b&gt;no employed member&lt;/b&gt; (hh_no_earner = 1) &lt;b&gt;and nobody on medical aid&lt;/b&gt; (hh_any_medaid = 0).&lt;br&gt;&#160;&#160;&#8594; 97,390 child records. Within this group 85.7% do receive a grant, so non-receipt cannot be explained by being above the means test.&lt;br&gt;&lt;br&gt;&lt;b&gt;Label:&lt;/b&gt;&#160;&#160;y = (1 - grant_any)&#160;&#160;where grant_any = grant.map({'Yes': 1, 'No': 0})&lt;br&gt;&lt;br&gt;&lt;b&gt;y = 1&lt;/b&gt;&#160;&#160;(positive, 14.26% of rows)&#160;&#160;an apparently eligible child who is &lt;b&gt;NOT&lt;/b&gt; receiving a grant&#160;&#160;=&#160;&#160;a &lt;b&gt;reach failure&lt;/b&gt; - the thing the model exists to find&lt;br&gt;&lt;b&gt;y = 0&lt;/b&gt;&#160;&#160;(negative, 85.74% of rows)&#160;&#160;same population, grant is being received&lt;br&gt;&lt;br&gt;&lt;i&gt;The label is deliberately inverted so that sorting by predicted probability produces an outreach priority list directly.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="1500" height="200" as="geometry" />
        </mxCell>

        <mxCell id="V1" value="&lt;b&gt;INDEPENDENT VARIABLES - 11 NUMERIC&lt;/b&gt;&lt;br&gt;&lt;i&gt;imputed with the training median, then standardised&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1.&#160;&#160;age&lt;/b&gt;&lt;br&gt;&#160;&#160;&#160;&#160;&#160;the child's age in completed years, 0-17&lt;br&gt;&lt;b&gt;2.&#160;&#160;hh_size&lt;/b&gt;&lt;br&gt;&#160;&#160;&#160;&#160;&#160;number of people in the household&lt;br&gt;&lt;b&gt;3.&#160;&#160;hh_n_child_0_17&lt;/b&gt;&lt;br&gt;&#160;&#160;&#160;&#160;&#160;members aged 17 or under&lt;br&gt;&lt;b&gt;4.&#160;&#160;hh_n_elderly_60p&lt;/b&gt;&lt;br&gt;&#160;&#160;&#160;&#160;&#160;members aged 60 or over (likely OAG recipients)&lt;br&gt;&lt;b&gt;5.&#160;&#160;hh_mean_age&lt;/b&gt;&lt;br&gt;&#160;&#160;&#160;&#160;&#160;average age of all members&lt;br&gt;&lt;b&gt;6.&#160;&#160;hh_max_age&lt;/b&gt;&lt;br&gt;&#160;&#160;&#160;&#160;&#160;age of the oldest member&lt;br&gt;&lt;b&gt;7.&#160;&#160;hh_n_unemployed&lt;/b&gt;&lt;br&gt;&#160;&#160;&#160;&#160;&#160;members who are jobless and actively seeking&lt;br&gt;&lt;b&gt;8.&#160;&#160;hh_n_disabled&lt;/b&gt;&lt;br&gt;&#160;&#160;&#160;&#160;&#160;members reported as disabled&lt;br&gt;&lt;b&gt;9.&#160;&#160;hh_max_educ&lt;/b&gt;&lt;br&gt;&#160;&#160;&#160;&#160;&#160;highest attainment in the household, as an&lt;br&gt;&#160;&#160;&#160;&#160;&#160;EDUC_ORDER index 0-4 (proxy for the caregiver's&lt;br&gt;&#160;&#160;&#160;&#160;&#160;capacity to navigate the application process)&lt;br&gt;&lt;b&gt;10. hh_dependency_ratio&lt;/b&gt;&lt;br&gt;&#160;&#160;&#160;&#160;&#160;(children + elderly) / household size&lt;br&gt;&lt;b&gt;11. hh_salary_per_capita&lt;/b&gt;&lt;br&gt;&#160;&#160;&#160;&#160;&#160;summed reported salary / household size.&lt;br&gt;&#160;&#160;&#160;&#160;&#160;Sparse (~20% populated) so mostly imputed;&lt;br&gt;&#160;&#160;&#160;&#160;&#160;kept because when present it carries signal." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="305" width="480" height="560" as="geometry" />
        </mxCell>

        <mxCell id="V2" value="&lt;b&gt;INDEPENDENT VARIABLES - 8 CATEGORICAL&lt;/b&gt;&lt;br&gt;&lt;i&gt;missing filled with '__NA__', then one-hot encoded&lt;br&gt;(min_frequency = 20, unknown levels ignored)&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;12. sex&lt;/b&gt;&#160;&#160;Male | Female&lt;br&gt;&lt;br&gt;&lt;b&gt;13. race&lt;/b&gt;&#160;&#160;population group&lt;br&gt;&#160;&#160;&#160;&#160;&#160;African/Black | Coloured | Indian/Asian | White&lt;br&gt;&#160;&#160;&#160;&#160;&#160;&lt;i&gt;sensitive attribute, deliberately retained&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;14. prov&lt;/b&gt;&#160;&#160;province&lt;br&gt;&#160;&#160;&#160;&#160;&#160;Western Cape | Eastern Cape | Northern Cape |&lt;br&gt;&#160;&#160;&#160;&#160;&#160;Free State | KwaZulu-Natal | North West |&lt;br&gt;&#160;&#160;&#160;&#160;&#160;Gauteng | Mpumalanga | Limpopo&lt;br&gt;&lt;br&gt;&lt;b&gt;15. geotype&lt;/b&gt;&#160;&#160;settlement type&lt;br&gt;&#160;&#160;&#160;&#160;&#160;Urban | Traditional | Rural formal&lt;br&gt;&#160;&#160;&#160;&#160;&#160;&lt;i&gt;harmonised from two different survey schemes&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;16. educ_band&lt;/b&gt;&#160;&#160;the child's own attainment&lt;br&gt;&#160;&#160;&#160;&#160;&#160;No schooling | Primary or less | Some secondary |&lt;br&gt;&#160;&#160;&#160;&#160;&#160;Matric (Grade 12) | Post-school&lt;br&gt;&lt;br&gt;&lt;b&gt;17. attend&lt;/b&gt;&#160;&#160;currently attending an institution&lt;br&gt;&#160;&#160;&#160;&#160;&#160;Yes | No&#160;&#160;&#160;(&lt;b&gt;NaN below age 5&lt;/b&gt; - survey skip)&lt;br&gt;&lt;br&gt;&lt;b&gt;18. disab&lt;/b&gt;&#160;&#160;Not disabled | Disabled&lt;br&gt;&lt;br&gt;&lt;b&gt;19. lab_status&lt;/b&gt;&#160;&#160;derived labour status&lt;br&gt;&#160;&#160;&#160;&#160;&#160;Employed | Unemployed | Not economically active&lt;br&gt;&#160;&#160;&#160;&#160;&#160;(&lt;b&gt;NaN below age 15&lt;/b&gt; - survey skip)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="560" y="305" width="480" height="560" as="geometry" />
        </mxCell>

        <mxCell id="V3" value="&lt;b&gt;DELIBERATELY NOT USED AS FEATURES&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;A. Dropped as zero-variance (5)&lt;/b&gt;&lt;br&gt;Inside the eligible population these &lt;i&gt;are&lt;/i&gt; the filter,&lt;br&gt;so they never vary and the model cannot learn from them:&lt;br&gt;&#160;&#160;hh_n_employed&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;always 0&lt;br&gt;&#160;&#160;hh_workers_per_capita&#160;&#160;always 0&lt;br&gt;&#160;&#160;hh_no_earner&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;always 1&lt;br&gt;&#160;&#160;hh_any_medaid&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;always 0&lt;br&gt;&#160;&#160;medaid&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;always 'No'&lt;br&gt;&lt;i&gt;Present in the 24-column pre-optimisation contract,&lt;br&gt;removed by the search (drop_constant = True) and&lt;br&gt;confirmed harmless to remove by ablation A2.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;B. Leakage - never even loaded&lt;/b&gt;&lt;br&gt;Questions asked only of people who already said yes&lt;br&gt;to a grant: soc_grant_csg / oag / dis / srd,&lt;br&gt;soc_grant_type, soc_disb_perm, Q31b*, Q132b*,&lt;br&gt;Q32disg, Q33csgw, Q133disg, Q134csgw.&lt;br&gt;&lt;i&gt;Using any of them lifts ROC-AUC 0.906 to 0.993 and&lt;br&gt;is impossible at prediction time.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;C. Identifiers, design and intermediates&lt;/b&gt;&lt;br&gt;uqnr, personnr, psu, stratum, hh, year, split,&lt;br&gt;grant, grant_any, hh_total_salary, sevdisab,&lt;br&gt;and the raw activity flags wage / bus / vol / ret /&lt;br&gt;look / sto (consumed to build lab_status).&lt;br&gt;&lt;br&gt;&lt;b&gt;D. weight (person_wgt)&lt;/b&gt;&lt;br&gt;Used as sample_weight in every reported metric.&lt;br&gt;&lt;b&gt;Never&lt;/b&gt; passed to .fit() or to the loss." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1080" y="305" width="460" height="560" as="geometry" />
        </mxCell>

        <mxCell id="V4" value="&lt;b&gt;MODEL CARD - the deployed model&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Name&lt;/b&gt;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;'Optimised MLP' (ghs_inference.CHAMPION)&lt;br&gt;&lt;b&gt;Type&lt;/b&gt;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;feed-forward neural net, PyTorch&lt;br&gt;&lt;b&gt;Input&lt;/b&gt;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;one-hot design matrix over 19 features&lt;br&gt;&lt;b&gt;Blocks&lt;/b&gt;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;Linear &#8594; BatchNorm1d &#8594; ReLU &#8594; Dropout&lt;br&gt;&lt;b&gt;Hidden&lt;/b&gt;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;(512, 256, 128)&lt;br&gt;&lt;b&gt;Dropout&lt;/b&gt;&#160;&#160;&#160;&#160;&#160;&#160;&#160;0.1&lt;br&gt;&lt;b&gt;Output&lt;/b&gt;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;Linear(&#8594;1) logit &#8594; sigmoid&lt;br&gt;&lt;b&gt;Loss&lt;/b&gt;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;BCEWithLogitsLoss(pos_weight = 3.0)&lt;br&gt;&lt;b&gt;Optimiser&lt;/b&gt;&#160;&#160;&#160;&#160;&#160;AdamW, lr 0.002, weight_decay 1e-5&lt;br&gt;&lt;b&gt;Batch&lt;/b&gt;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;2048, grad clip 5.0&lt;br&gt;&lt;b&gt;Epochs&lt;/b&gt;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;early-stopped at epoch 4 (patience 6)&lt;br&gt;&lt;b&gt;Encoder&lt;/b&gt;&#160;&#160;&#160;&#160;&#160;&#160;&#160;median impute + StandardScaler;&lt;br&gt;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;'__NA__' + OneHot(min_frequency 20)&lt;br&gt;&lt;b&gt;Calibration&lt;/b&gt;&#160;&#160;&#160;isotonic, fit on 2019, checked on 2020&lt;br&gt;&lt;b&gt;Seed&lt;/b&gt;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;42&lt;br&gt;&lt;b&gt;Selected by&lt;/b&gt;&#160;&#160;&#160;40-trial random search on survey-weighted&lt;br&gt;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;PR-AUC over 2019-2020&lt;br&gt;&lt;b&gt;Artefacts&lt;/b&gt;&#160;&#160;&#160;&#160;&#160;mlp_optimised_csg_reach_gap.pt&lt;br&gt;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;optimised_bundle_csg_reach_gap.joblib&lt;br&gt;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;calibrators_csg_reach_gap.joblib" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="890" width="480" height="420" as="geometry" />
        </mxCell>

        <mxCell id="V5" value="&lt;b&gt;DATA AND SPLIT&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Source&lt;/b&gt;&#160;&#160;Stats SA General Household Survey,&lt;br&gt;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;11 annual person-level files, 2012-2022&lt;br&gt;&lt;b&gt;Raw pooled&lt;/b&gt;&#160;&#160;773,311 person records&lt;br&gt;&lt;b&gt;Modelling population&lt;/b&gt;&#160;&#160;97,390 child records&lt;br&gt;&lt;br&gt;&lt;b&gt;Split strategy: time-based, by survey year&lt;/b&gt;&lt;br&gt;&lt;i&gt;not random - psu ids repeat within a year, so a&lt;br&gt;random split would leak geographic neighbours&lt;/i&gt;&lt;br&gt;&lt;br&gt;&#160;&#160;&lt;b&gt;TRAIN&lt;/b&gt;&#160;&#160;&#160;&#160;&#160;&#160;&#160;2012-2018&#160;&#160;&#8776; 71,080&#160;&#160;&#8776; 73%&lt;br&gt;&#160;&#160;&lt;b&gt;VALIDATION&lt;/b&gt;&#160;&#160;2019-2020&#160;&#160;&#8776; 12,849&#160;&#160;&#8776; 13%&lt;br&gt;&#160;&#160;&lt;b&gt;TEST&lt;/b&gt;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;2021-2022&#160;&#160;&#160;&#160;13,461&#160;&#160;&#8776; 14%&lt;br&gt;&lt;br&gt;&lt;b&gt;Nested use during tuning&lt;/b&gt;&lt;br&gt;&#160;&#160;fit 2012-2017 &#183; early-stop 2018&lt;br&gt;&#160;&#160;select on 2019-2020&lt;br&gt;&#160;&#160;calibrate: fit 2019, check 2020&lt;br&gt;&#160;&#160;&lt;b&gt;test read exactly once, at the end&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Cross-validation&lt;/b&gt;&#160;&#160;leave-one-year-out over the 7&lt;br&gt;training years: PR-AUC 0.3072 &#177; 0.0349,&lt;br&gt;ROC-AUC 0.6818 &#177; 0.0076&lt;br&gt;&lt;br&gt;&lt;b&gt;Class balance&lt;/b&gt;&#160;&#160;14.26% positive overall;&lt;br&gt;0.154 train &#8594; 0.1066 validation (improving reach)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="560" y="890" width="480" height="420" as="geometry" />
        </mxCell>

        <mxCell id="V6" value="&lt;b&gt;PERFORMANCE&lt;/b&gt;&#160;&#160;survey-weighted throughout&lt;br&gt;&lt;br&gt;&lt;b&gt;Model comparison (validation 2019-2020)&lt;/b&gt;&lt;br&gt;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;ROC&#160;&#160;&#160;&#160;&#160;PR&#160;&#160;&#160;&#160;&#160;&#160;macroF1&lt;br&gt;Dummy (prior)&#160;&#160;&#160;&#160;&#160;&#160;&#160;0.500&#160;&#160;0.1066&#160;&#160;0.472&lt;br&gt;Logistic Regression&#160;0.663&#160;&#160;0.2035&#160;&#160;0.505&lt;br&gt;Random Forest&#160;&#160;&#160;&#160;&#160;&#160;&#160;0.684&#160;&#160;0.2292&#160;&#160;&lt;b&gt;0.580&lt;/b&gt;&lt;br&gt;MLP (pre-optimised)&#160;&lt;b&gt;0.685&lt;/b&gt;&#160;&#160;0.2327&#160;&#160;0.527&lt;br&gt;TabTransformer&#160;&#160;&#160;&#160;&#160;&#160;0.670&#160;&#160;0.2072&#160;&#160;0.464&lt;br&gt;&lt;b&gt;Optimised MLP&#160;&#160;&#160;&#160;&#160;&#160;&#160;0.676&#160;&#160;0.2446&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Locked test (2021-2022, read once)&lt;/b&gt;&lt;br&gt;&#160;&#160;ROC-AUC&#160;&#160;&lt;b&gt;0.6911&lt;/b&gt;&#160;&#160;&#160;&#160;PR-AUC&#160;&#160;&lt;b&gt;0.2708&lt;/b&gt;&lt;br&gt;&#160;&#160;lift@5%&#160;&#160;&lt;b&gt;3.52&lt;/b&gt;&#160;&#160;&#160;&#160;&#160;&#160;lift@10% &lt;b&gt;2.77&lt;/b&gt;&lt;br&gt;&lt;i&gt;visiting the top 5% of the ranked list finds 3.5x&lt;br&gt;as many unreached children as visiting 5% at random&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Calibration (2020 check)&lt;/b&gt;&lt;br&gt;&#160;&#160;Brier 0.2066 &#8594; &lt;b&gt;0.0790&lt;/b&gt;&#160;&#160;&#160;ECE 0.3511 &#8594; &lt;b&gt;0.0359&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;McNemar vs Random Forest&lt;/b&gt;&lt;br&gt;&#160;&#160;thr 0.5&#160;&#160;&#160;&#160;&#160;&#160;&#160;chi2 3.61&#160;&#160;p = 0.057&lt;br&gt;&#160;&#160;top-10% rule&#160;&#160;stat 0.050&#160;&#160;p = 0.823&lt;br&gt;&#160;&#160;&#8594; &lt;b&gt;fail to reject&lt;/b&gt;: statistically indistinguishable" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1080" y="890" width="460" height="420" as="geometry" />
        </mxCell>

        <mxCell id="V7" value="&lt;b&gt;DECISION RULE AND SCOPE&lt;/b&gt;&#160;&#160;&#160;There is no tuned scalar threshold. Scores are calibrated, ranked, and consumed against capacity: &lt;b&gt;lift = calibrated probability / population base rate&lt;/b&gt;&#160;&#160;&#8594;&#160;&#160;&#8805; 3.0x &lt;b&gt;Very high&lt;/b&gt; (visit first)&#160;&#160;&#183;&#160;&#160;&#8805; 2.0x &lt;b&gt;High&lt;/b&gt; (include this round)&#160;&#160;&#183;&#160;&#160;&#8805; 1.25x &lt;b&gt;Elevated&lt;/b&gt; (if capacity allows)&#160;&#160;&#183;&#160;&#160;otherwise &lt;b&gt;Typical or low&lt;/b&gt; (no action).&lt;br&gt;&lt;b&gt;Refusals are part of the contract.&lt;/b&gt; ghs_inference refuses to score, with a named reason, when: age is outside 0-17&#160;&#160;&#183;&#160;&#160;a child under 15 is the only household member&#160;&#160;&#183;&#160;&#160;any member is employed&#160;&#160;&#183;&#160;&#160;anyone has medical aid&#160;&#160;&#183;&#160;&#160;a required field is missing or carries a level the training data never contained. Those last two conditions are the eligibility proxy; outside them &quot;no grant&quot; is not interpretable as a reach failure.&lt;br&gt;&lt;b&gt;Stated limitation:&lt;/b&gt; this is a statistical priority score derived from survey patterns, not a determination of eligibility - only SASSA can determine eligibility." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontSize=12;fillColor=#b1ddf0;strokeColor=#10739e;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="1335" width="1500" height="135" as="geometry" />
        </mxCell>

        <mxCell id="S0" value="&lt;b&gt;PIPELINE AT A GLANCE&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="1490" width="400" height="30" as="geometry" />
        </mxCell>
