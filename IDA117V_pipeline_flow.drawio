        <mxCell id="e6" value="each year is harmonised on load" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=3;strokeColor=#333333;endArrow=blockThin;endFill=1;fontSize=10;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="A4" target="B1"><mxGeometry relative="1" as="geometry" /></mxCell>
