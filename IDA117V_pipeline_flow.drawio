        <mxCell id="e22" value="97,390 labelled rows" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=3;strokeColor=#333333;endArrow=blockThin;endFill=1;fontSize=10;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="D4" target="E2"><mxGeometry relative="1" as="geometry" /></mxCell>
